# Flask
PORT=5000
FLASK_DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production
CORS_ORIGINS=*

# Database
# Local dev default: sqlite:///label_verification.db
# Production: paste your Postgres connection string (postgres:// or postgresql://)
DATABASE_URL=sqlite:///label_verification.db

# Uploads
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=16

# OCR
SURYA_OCR_LANGS=en

# Validation (REQUIRED)
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=

# Optional Windows dependency for PDF processing
# POPPLER_PATH=
