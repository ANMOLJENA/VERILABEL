# Flask
PORT=5000
FLASK_DEBUG=true
SECRET_KEY=change-this-in-production
CORS_ORIGINS=http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///label_verification.db

# Uploads
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=16

# OCR
OCR_PRIMARY_ENGINE=ollama
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=glm-ocr:latest
OLLAMA_TIMEOUT=120
OLLAMA_PDF_WORKERS=4

# Validation (REQUIRED)
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=take_it_from_whatsapp

# Optional Windows dependency for PDF processing
# POPPLER_PATH=C:\Program Files\poppler\Library\bin
